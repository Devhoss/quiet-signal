<?xml version="1.0" encoding="utf-8"?>
<!--
    Clear surface: transparent liquid-glass panel for wallpaper-backed
    rendering. No drop shadow, no dark fill - only a subtle glass rim and
    the top specular arc. The switch remains the primary visual element.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Transparent body with subtle glass rim -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
    <!-- Top-edge Specular Reflection Arc -->
    <item android:top="1dp" android:left="8dp" android:right="8dp" android:height="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="1dp" />
            <solid android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>