<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Luminous intensity variant -->
    <!-- Outer Amber Subtle Base -->
    <item android:left="7dp" android:top="5dp" android:right="7dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#59F57C00" />
            <size android:width="44dp" android:height="24dp" />
        </shape>
    </item>
    <!-- Liquid Mini Track Body - Disconnecting -->
    <item android:top="6dp" android:bottom="6dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#BF1C1006"
                android:endColor="#732A180A" />
            <stroke
                android:width="1dp"
                android:color="#8CF57C00" />
        </shape>
    </item>
    <!-- Mini Thumb Body (Mid-Left / Disconnecting) -->
    <item android:left="15dp" android:right="25dp" android:top="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="12dp"
                android:centerX="0.35"
                android:centerY="0.28"
                android:startColor="#E6FFFFFF"
                android:centerColor="#A66F33"
                android:endColor="#331C08" />
            <stroke
                android:width="1dp"
                android:color="#59FFB74D" />
        </shape>
    </item>
    <!-- Mini Thumb Glint -->
    <item android:left="18dp" android:right="32dp" android:top="9dp" android:bottom="18dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#D9FFFFFF"
                android:endColor="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
