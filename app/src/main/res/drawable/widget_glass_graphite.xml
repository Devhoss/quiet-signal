<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Drop Shadow Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="#F0080A0E" />
        </shape>
    </item>
    <!-- Liquid Glass Graphite Body -->
    <item android:top="1dp" android:bottom="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#6B262E36"
                android:endColor="#E610141A" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
    <!-- Top-edge Specular Reflection Arc -->
    <item android:top="1dp" android:left="8dp" android:right="8dp" android:height="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="1dp" />
            <solid android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
