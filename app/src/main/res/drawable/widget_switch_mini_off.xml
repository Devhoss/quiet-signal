<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Track Shadow -->
    <item android:left="7dp" android:top="5dp" android:right="7dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#80000000" />
            <size android:width="44dp" android:height="24dp" />
        </shape>
    </item>
    <!-- Liquid Mini Track Body -->
    <item android:top="6dp" android:bottom="6dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#C7020406"
                android:endColor="#850E1218" />
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>
    <!-- Mini Thumb Body (Left / Off) -->
    <item android:left="10dp" android:right="30dp" android:top="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="12dp"
                android:centerX="0.35"
                android:centerY="0.28"
                android:startColor="#FFFFFF"
                android:centerColor="#78847E"
                android:endColor="#1D2220" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    <!-- Mini Thumb Glint -->
    <item android:left="13dp" android:right="37dp" android:top="9dp" android:bottom="18dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#E6FFFFFF"
                android:endColor="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
