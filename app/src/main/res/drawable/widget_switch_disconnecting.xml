<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Receding Amber Track Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <solid android:color="#24F57C00" />
            <size android:width="62dp" android:height="34dp" />
        </shape>
    </item>
    <!-- Liquid Channel (Track) Body - Receding -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#BF1C1006"
                android:endColor="#732A180A" />
            <stroke
                android:width="1dp"
                android:color="#59F57C00" />
        </shape>
    </item>
    <!-- Thumb Inset Deep Shadow -->
    <item android:left="10dp" android:right="24dp" android:top="4dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#B30C0803" />
        </shape>
    </item>
    <!-- Thumb Body - Receding Amber Gradient -->
    <item android:left="10dp" android:right="24dp" android:top="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="18dp"
                android:centerX="0.35"
                android:centerY="0.28"
                android:startColor="#E6FFFFFF"
                android:centerColor="#A66F33"
                android:endColor="#331C08" />
            <stroke
                android:width="1dp"
                android:color="#59FFB74D" />
        </shape>
    </item>
    <!-- Thumb Specular Meniscus Glint -->
    <item android:left="14dp" android:right="34dp" android:top="5dp" android:bottom="19dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#D9FFFFFF"
                android:endColor="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
