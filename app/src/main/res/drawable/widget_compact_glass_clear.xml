<?xml version="1.0" encoding="utf-8"?>
<!--
    Clear squircle surface for the 1x1 widget: the housing becomes
    transparent while retaining only the subtle glass edge treatment.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
    <!-- Top-edge Specular Arc -->
    <item android:top="1dp" android:left="6dp" android:right="6dp" android:height="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="1dp" />
            <solid android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>