<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Luminous intensity variant -->
    <!-- Ambient Amber Pulse Behind Track -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <solid android:color="#66ADB74D" />
            <size android:width="62dp" android:height="34dp" />
        </shape>
    </item>
    <!-- Liquid Channel (Track) Body - Amber Transitive -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#D9241508"
                android:endColor="#8C3A220E" />
            <stroke
                android:width="1dp"
                android:color="#B3FFB74D" />
        </shape>
    </item>
    <!-- Thumb Inset Deep Shadow -->
    <item android:left="17dp" android:right="17dp" android:top="4dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#B30C0803" />
        </shape>
    </item>
    <!-- Thumb Body - Amber Liquid Transit Gradient -->
    <item android:left="17dp" android:right="17dp" android:top="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="18dp"
                android:centerX="0.35"
                android:centerY="0.28"
                android:startColor="#FFFFFF"
                android:centerColor="#D68A36"
                android:endColor="#4D2A08" />
            <stroke
                android:width="1dp"
                android:color="#80FFD180" />
        </shape>
    </item>
    <!-- Thumb Specular Meniscus Glint -->
    <item android:left="21dp" android:right="27dp" android:top="5dp" android:bottom="19dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F0FFFFFF"
                android:endColor="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
