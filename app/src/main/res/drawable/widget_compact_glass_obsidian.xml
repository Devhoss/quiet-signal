<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Drop Shadow Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#F0040608" />
        </shape>
    </item>
    <!-- Liquid Glass Squircle Body -->
    <item android:top="1dp" android:bottom="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#47161E26"
                android:endColor="#D906080C" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
    <!-- Top-edge Specular Arc -->
    <item android:top="1dp" android:left="6dp" android:right="6dp" android:height="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="1dp" />
            <solid android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
