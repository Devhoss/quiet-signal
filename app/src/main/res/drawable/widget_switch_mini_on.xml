<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Green Glow Base -->
    <item android:left="7dp" android:top="5dp" android:right="7dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#3386C156" />
            <size android:width="44dp" android:height="24dp" />
        </shape>
    </item>
    <!-- Liquid Mini Track Body - Illuminated Green -->
    <item android:top="6dp" android:bottom="6dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#CC0A180C"
                android:endColor="#8C142A16" />
            <stroke
                android:width="1dp"
                android:color="#8C86C156" />
        </shape>
    </item>
    <!-- Mini Thumb Body (Right / On) -->
    <item android:left="30dp" android:right="10dp" android:top="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="12dp"
                android:centerX="0.35"
                android:centerY="0.28"
                android:startColor="#FFFFFF"
                android:centerColor="#78AB48"
                android:endColor="#223514" />
            <stroke
                android:width="1dp"
                android:color="#80B4F578" />
        </shape>
    </item>
    <!-- Mini Thumb Glint -->
    <item android:left="33dp" android:right="17dp" android:top="9dp" android:bottom="18dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F0FFFFFF"
                android:endColor="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
