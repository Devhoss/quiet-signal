<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Track Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <solid android:color="#80000000" />
            <size android:width="62dp" android:height="34dp" />
        </shape>
    </item>
    <!-- Liquid Channel (Track) Body -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#C7020406"
                android:endColor="#850E1218" />
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>
    <!-- Thumb Deep Inset Shadow -->
    <item android:left="3dp" android:right="31dp" android:top="4dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#B3000000" />
        </shape>
    </item>
    <!-- Thumb Body (Obsidian / Metallic Liquid Gradient) -->
    <item android:left="3dp" android:right="31dp" android:top="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="18dp"
                android:centerX="0.35"
                android:centerY="0.28"
                android:startColor="#FFFFFF"
                android:centerColor="#78847E"
                android:endColor="#1D2220" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    <!-- Thumb Specular Meniscus Glint -->
    <item android:left="7dp" android:right="41dp" android:top="5dp" android:bottom="19dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#E6FFFFFF"
                android:endColor="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
